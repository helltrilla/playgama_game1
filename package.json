{
  "name": "coins-table",
  "private": true,
  "version": "1.7.1",
  "type": "module",
  "description": "Coins Table - idle game on three.js for Playgama",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" && prettier --check \"src/**/*.{ts,css}\"",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:compliance": "node scripts/compliance-scan.mjs",
    "build": "tsc --noEmit && vite build",
    "package": "npm run build && node scripts/zip.mjs && node scripts/compliance-scan.mjs dist",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run package",
    "preview": "vite preview --host 127.0.0.1 --port 4173"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@fontsource/nunito": "^5.1.0",
    "@fontsource/philosopher": "^5.1.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "@types/three": "^0.170.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "fast-check": "^3.23.0",
    "fflate": "^0.8.2",
    "playwright": "^1.49.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.4"
  }
}
